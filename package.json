{
  "name": "neopian-desk-public",
  "version": "1.0.0-beta.1",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "build": "node tools/build.mjs",
    "start": "electron .",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:desktop": "node tests/desktop.cjs",
    "dist:win": "npm run build && node tools/package-windows.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.6.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.24.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.25.0",
    "linkedom": "^0.18.13",
    "prettier": "3.8.3",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.0.0",
    "typescript": "5.9.3",
    "electron": "44.8.0",
    "electron-builder": "26.15.3",
    "@playwright/test": "1.64.1"
  },
  "description": "A personal Neopets companion for Windows",
  "main": "desktop/main.cjs",
  "author": "Neopian Desk",
  "license": "UNLICENSED",
  "build": {
    "appId": "org.neopiandesk.public",
    "productName": "Neopian Desk",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "desktop/**",
      "package.json",
      "ADMINCN-LICENSE.md"
    ],
    "extraResources": [
      {
        "from": "windows/publish",
        "to": "overlay",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "Neopian-Desk-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true
    }
  }
}
